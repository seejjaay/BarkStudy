{
  "name": "barkstudy",
  "version": "0.0.0",
  "private": true,
  "description": "Pandesal, a Windows desktop study companion that walks real title bars and schedules your flashcards.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.engine.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "explore": "tsx scripts/explore.ts",
    "replay": "tsx scripts/replay.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "e2e": "electron-vite build && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "koffi": "3.3.3",
    "ts-fsrs": "5.4.2"
  },
  "main": "out/main/index.cjs"
}
