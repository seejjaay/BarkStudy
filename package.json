{
  "name": "barkstudy",
  "version": "0.0.0",
  "private": true,
  "description": "Pandesal, a Windows desktop study companion that walks real title bars and schedules your flashcards.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.engine.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "explore": "tsx scripts/explore.ts",
    "replay": "tsx scripts/replay.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
